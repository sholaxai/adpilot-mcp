{
  "name": "adpilot-mcp",
  "version": "0.2.0",
  "description": "MCP server that lets AI assistants analyse and safely manage ad campaigns with anomaly detection, ROAS-based budget reallocation and hard spend guardrails.",
  "type": "module",
  "bin": {
    "adpilot-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ads",
    "meta-ads",
    "budget-optimization",
    "anomaly-detection",
    "ai-agents"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sholaxai/adpilot-mcp"
  }
}
